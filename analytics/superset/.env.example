# Скопируй в .env и заполни:  cp .env.example .env
# (setup-vps.sh создаст .env сам и сгенерирует ключ и пароль)

# Адрес дашборда. DNS: запись A «stats» → IP сервера.
# Своего домена нет? Подойдёт <IP-сервера>.sslip.io, например 203.0.113.10.sslip.io
DOMAIN=stats.example.ru

# Длинная случайная строка: openssl rand -hex 32
SUPERSET_SECRET_KEY=

# Пароль пользователя admin в Superset
ADMIN_PASSWORD=

# Та же база, что в Vercel (Storage → Neon → .env.local → DATABASE_URL)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# 1 — дашборд открывается по ссылке без логина (удобно для жюри по QR). 0 — только по логину.
SUPERSET_PUBLIC=1
